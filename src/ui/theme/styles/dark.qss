/* ============================================================
 * 深色主题
 * 与 light.qss 选择器一一对应，只改配色 ——
 * 这就是"主题"的本质：同一套结构，不同的颜色值。
 * 以后加新主题 = 复制一份换颜色，不用改任何 C++ 代码。
 * ============================================================ */

QMainWindow, QDialog {
    background-color: #2b2b2b;
}

/* 弹窗头部条：与 light.qss 同选择器，只换颜色 */
QWidget#appDialogHeader {
    background-color: #333333;
    border-bottom: 1px solid #404040;
}

QMenuBar {
    background-color: #232323;
    color: #dddddd;
}
QMenuBar::item:selected {
    background-color: #3d3d3d;
}

QMenu {
    background-color: #2b2b2b;
    color: #dddddd;
    border: 1px solid #404040;
}
QMenu::item:selected {
    background-color: #3d5a9e;
}

QStatusBar {
    background-color: #232323;
    color: #bbbbbb;
}

/* 侧边导航栏（与 light.qss 同选择器，只换配色） */
QWidget#navBar {
    background-color: #232323;
}
QToolButton#navItem {
    border: none;
    border-radius: 6px;
    border-left: 3px solid transparent;
    background: transparent;
}
QToolButton#navItem:hover {
    background-color: #333333;
}
QToolButton#navItem:checked {
    background-color: #3d3d3d;
    border-left: 3px solid #6a9bff;
}

QLabel {
    background: transparent;
    color: #e0e0e0;
}

QPushButton {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 14px;
}
QPushButton:hover {
    background-color: #464646;
}
QPushButton:pressed {
    background-color: #2e2e2e;
}

/* ---------- AppButton 变体（与 light.qss 相同的选择器，不同的配色） ---------- */

QPushButton[variant="Primary"] {
    background-color: #3d7fe0;
    color: #ffffff;
    border: none;
}
QPushButton[variant="Primary"]:hover {
    background-color: #4d8fea;
}
QPushButton[variant="Primary"]:pressed {
    background-color: #2f6fcc;
}

QPushButton[variant="Danger"] {
    background-color: #c94b47;
    color: #ffffff;
    border: none;
}
QPushButton[variant="Danger"]:hover {
    background-color: #d85a55;
}
QPushButton[variant="Danger"]:pressed {
    background-color: #b23f3b;
}

QPushButton[variant="Secondary"] {
    background-color: transparent;
    color: #8fb4f0;
    border: 1px solid #4a5f85;
}
QPushButton[variant="Secondary"]:hover {
    background-color: #333c4d;
}
QPushButton[variant="Secondary"]:pressed {
    background-color: #2a3240;
}